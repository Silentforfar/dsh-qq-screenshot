{
  "name": "@silentforfar/dsh-qq-screenshot",
  "version": "0.1.0",
  "description": "Capture a screen region with QQ's own screenshot tool and share it with the agent.",
  "type": "module",
  "license": "MIT",
  "author": "Silentforfar",
  "homepage": "https://github.com/Silentforfar/dsh-qq-screenshot#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Silentforfar/dsh-qq-screenshot.git"
  },
  "bugs": {
    "url": "https://github.com/Silentforfar/dsh-qq-screenshot/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "dsh-bundle",
    "screenshot",
    "qq",
    "windows",
    "image",
    "vision"
  ],
  "engines": {
    "dsh": ">=0.2.1-rc.2"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "capture.ps1",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
